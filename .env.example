# ===== Settled environment configuration =====
# Copy to .env and adjust as needed

# PostgreSQL
POSTGRES_DB=settled
POSTGRES_USER=settled
POSTGRES_PASSWORD=settled
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6380

# JWT
JWT_SECRET=settled-dev-secret-key-change-me-in-production-0123456789abcdef
JWT_EXPIRATION_MS=86400000

# Backend
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=3000
